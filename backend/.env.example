# Copy to .env for local development and replace the example values.
DJANGO_SECRET_KEY=generate-a-unique-secret-with-python-secrets
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local-only PostgreSQL example. Keep the username/password synchronized with compose.yaml.
POSTGRES_DB=onepay
POSTGRES_USER=onepay
POSTGRES_PASSWORD=replace-this-local-development-password
DATABASE_URL=postgresql://onepay:replace-this-local-development-password@127.0.0.1:5432/onepay

# The Vite dev proxy is same-origin to the browser. Trust the e2b preview origin only for local preview.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.e2b.app
SESSION_COOKIE_SAMESITE=Lax
COOKIE_SECURE=false
SESSION_COOKIE_AGE=43200

FRONTEND_BASE_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=OnePay Demo <no-reply@onepay.local>
# LocMemCache is local-process only. Configure a shared backend for multi-worker deployments.
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=onepay-local
SECURE_SSL_REDIRECT=false
# Set true only behind a reverse proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=false

# Intelligent Spending Analysis (optional). Local rule-based categorization is
# always used; external AI stays disabled unless explicitly configured and the
# user opts in on the Spending Insights page.
ANALYTICS_CACHE_SECONDS=60
ANALYTICS_CLASSIFIER_PATH=
ANALYTICS_EXTERNAL_LLM_ENABLED=false
ANALYTICS_EXTERNAL_LLM_ENDPOINT=
ANALYTICS_EXTERNAL_LLM_API_KEY=
ANALYTICS_EXTERNAL_LLM_TIMEOUT=4
